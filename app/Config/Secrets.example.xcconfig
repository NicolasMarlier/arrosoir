// Copier en Secrets.xcconfig (non versionné) puis remplir.
// Attention : dans un .xcconfig « // » ouvre un commentaire → écrire https:/$()/ au lieu de https://
SENTRY_DSN = https:/$()/<clé>@o<org-id>.ingest.de.sentry.io/<project-id>
SENTRY_ORG = <slug-de-l-organisation>
SENTRY_PROJECT = arrosoir
SENTRY_URL = https:/$()/de.sentry.io
